# Export these in your shell. The application does not automatically load .env.
# The offline demo and rules baseline need no credentials.
# A contact for SEC, sent only to sec.gov. Prefer `jevtrader setup`, which keeps it in
# config.json; use a dedicated alias, not a personal address. There is no default.
SEC_USER_AGENT=""
TYPESAFE_API_KEY=""
OPENAI_API_KEY=""
# Choose an available model explicitly when using the OpenAI provider.
OPENAI_MODEL=""
# Completed daily bars for the background service (a free Alpaca paper account).
# `jevtrader setup` can keep these and the keys above in the macOS Keychain instead.
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
